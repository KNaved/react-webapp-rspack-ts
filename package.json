{
  "name": "react-webapp-rspack-ts",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "rm -rf source-maps && rsbuild build",
    "browsers": "npx browserslist",
    "browsers:lint": "npx browserslist-lint",
    "eslint": "eslint src/* public/* --quiet --no-error-on-unmatched-pattern",
    "check": "eslint",
    "dev": "rsbuild dev --open",
    "doctor": "RSDOCTOR=true npm run build",
    "lint": "npm run tsc:lint && npm run eslint",
    "preview": "rsbuild preview --open",
    "supportedBrowsers": "echo \"// @ts-nocheck\nif (!window.supportedBrowsers) {\nObject.defineProperty(window, 'supportedBrowsers', {\nvalue:$(browserslist-useragent-regexp --allowHigherVersions),\nconfigurable: false,\nwritable: false\n})\n}\" > ./public/static/js/supportedBrowsers.js",
    "tsc:lint": "tsc --noEmit"
  },
  "dependencies": {
    "@am92/react-design-system": "2.10.6",
    "@am92/web-http": "2.0.29",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@reduxjs/toolkit": "2.8.2",
    "disable-devtool": "0.3.8",
    "localforage": "1.10.0",
    "lodash": "4.17.21",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "9.2.0",
    "react-router": "7.6.3",
    "redux": "5.0.1",
    "redux-persist": "6.0.0",
    "utility-types": "3.11.0"
  },
  "devDependencies": {
    "@aaroon/workbox-rspack-plugin": "0.3.2",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@rsbuild/core": "1.4.12",
    "@rsbuild/plugin-assets-retry": "1.4.0",
    "@rsbuild/plugin-basic-ssl": "1.2.0",
    "@rsbuild/plugin-image-compress": "1.3.0",
    "@rsbuild/plugin-node-polyfill": "1.4.0",
    "@rsbuild/plugin-react": "1.3.4",
    "@rsbuild/plugin-sass": "1.3.3",
    "@rsdoctor/rspack-plugin": "0.4.13",
    "@rspack/core": "1.4.11",
    "@types/multi-stage-sourcemap": "0.3.5",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "browserslist-useragent-regexp": "4.1.3",
    "cheerio": "1.1.2",
    "code-inspector-plugin": "0.20.17",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsonc": "2.20.1",
    "eslint-plugin-prettier": "5.5.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "4.1.4",
    "favicons": "7.2.0",
    "globals": "16.3.0",
    "htmlparser2": "10.0.0",
    "image-minimizer-webpack-plugin": "4.1.3",
    "javascript-obfuscator": "4.1.1",
    "jsonc-eslint-parser": "2.4.0",
    "lefthook": "1.12.2",
    "multi-stage-sourcemap": "0.3.1",
    "multimatch": "7.0.0",
    "prettier": "3.5.3",
    "rsbuild-plugin-ejs": "1.0.1",
    "rsbuild-plugin-html-minifier-terser": "1.1.1",
    "source-map": "0.7.6",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0"
  }
}
